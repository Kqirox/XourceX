# XourceX Backend Environment Variables

# Database
XOURCEX_DATABASE__URL=postgres://username:password@localhost/XOURCEX

# Server
XOURCEX_PORT=3000

# JWT Configuration
XOURCEX_JWT__SECRET=your-super-secret-jwt-key-change-this-in-production
XOURCEX_JWT__EXPIRATION_HOURS=24

# Stellar Network Configuration
XOURCEX_STELLAR__NETWORK__PASSPHRASE=Test SDF Network ; September 2015
XOURCEX_STELLAR__NETWORK__HORIZON_URL=https://horizon-testnet.stellar.org
XOURCEX_STELLAR__NETWORK__RPC_URL=https://soroban-testnet.stellar.org

# Anchor Configuration
XOURCEX_ANCHOR__SEP24_URL=https://your-anchor.com/sep24
XOURCEX_ANCHOR__SEP31_URL=https://your-anchor.com/sep31
XOURCEX_ANCHOR__WEBHOOK_SECRET=your-webhook-secret
XOURCEX_ANCHOR__KYC_REQUIRED=true

# Bridge Configuration
XOURCEX_BRIDGE__ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
XOURCEX_BRIDGE__POLYGON_RPC_URL=https://polygon-rpc.com
XOURCEX_BRIDGE__BSC_RPC_URL=https://bsc-dataseed.binance.org
XOURCEX_BRIDGE__SUPPORTED_ASSETS=["USDC", "USDT"]
XOURCEX_BRIDGE__MIN_BRIDGE_AMOUNT=1000000
XOURCEX_BRIDGE__MAX_BRIDGE_AMOUNT=100000000

# Compliance Configuration
XOURCEX_COMPLIANCE__SANCTIONS_API_URL=https://api.sanctions.example.com
XOURCEX_COMPLIANCE__SANCTIONS_API_KEY=your-api-key
XOURCEX_COMPLIANCE__VELOCITY_LIMITS__DAILY_TRANSACTION_LIMIT=10000000
XOURCEX_COMPLIANCE__VELOCITY_LIMITS__MONTHLY_TRANSACTION_LIMIT=100000000
XOURCEX_COMPLIANCE__VELOCITY_LIMITS__MAX_TRANSACTION_AMOUNT=5000000
XOURCEX_COMPLIANCE__RISK_THRESHOLDS__HIGH_RISK_AMOUNT=10000000
XOURCEX_COMPLIANCE__RISK_THRESHOLDS__MEDIUM_RISK_AMOUNT=1000000

# Environment
RUN_ENV=development